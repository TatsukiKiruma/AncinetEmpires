{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "apk:map-report": "node --openssl-legacy-provider --import tsx tools/apk_map_report.ts",
    "apk:script-report": "node --openssl-legacy-provider --import tsx tools/apk_script_report.ts",
    "apk:dex-report": "node --openssl-legacy-provider --import tsx tools/apk_dex_report.ts",
    "apk:terrain-report": "node --openssl-legacy-provider --import tsx tools/apk_terrain_report.ts",
    "apk:unit-report": "node --openssl-legacy-provider --import tsx tools/apk_unit_report.ts",
    "apk:language-rule-report": "node --openssl-legacy-provider --import tsx tools/apk_language_rule_report.ts",
    "apk:skirmish-rule-report": "node --openssl-legacy-provider --import tsx tools/apk_skirmish_rule_report.ts",
    "apk:training-report": "node --openssl-legacy-provider --import tsx tools/apk_training_report.ts",
    "train:skirmish:baseline": "node --openssl-legacy-provider --import tsx tools/skirmish_training_runner.ts",
    "eval:skirmish:baseline": "node --openssl-legacy-provider --import tsx tools/skirmish_training_eval.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
