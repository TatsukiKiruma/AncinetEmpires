# --- V12 generated heavy artifacts -----------------------------------------------
# 1.0 GB diagnostic copy of the 30k spatial dataset with recovered rootFamilyId.
# Reproducible in ~1 minute with: py -3.12 v12/tools/diag_inject_roots.py \
#   training_runs/spatial_dataset/spatial_train_scaled_30k.jsonl \
#   v12/out/spatial/diag_30k_with_roots.jsonl
# Kept on disk for reproduction, deliberately not committed.
v12/out/spatial/diag_30k_with_roots.jsonl

# Git bundle used to move these commits to a machine that can reach the remote
# (this sandbox cannot complete any TLS handshake, so `git push` is impossible here).
# Transfer artifact, never source.
*.bundle
